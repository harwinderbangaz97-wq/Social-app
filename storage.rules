rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Only authenticated users can read files
    match /{allPaths=**} {
      allow read: if request.auth != null;
    }

    // User Profile Avatars & Assets (max 20MB, must be images)
    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null 
                   && request.resource.size < 20 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Posts media (max 50MB, images)
    match /posts/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null 
                   && request.resource.size < 50 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Stories media (max 100MB, images and videos)
    match /stories/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null 
                   && request.resource.size < 100 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('video/.*'));
    }

    // Direct Messages & Chat media (images, voice audio, video)
    match /chats/{threadId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null 
                   && request.resource.size < 100 * 1024 * 1024;
    }

    // Community media & attachments
    match /communities/{communityId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null 
                   && request.resource.size < 100 * 1024 * 1024;
    }

    // General app uploads with size and auth restrictions
    match /uploads/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null 
                   && request.resource.size < 100 * 1024 * 1024;
    }
  }
}
