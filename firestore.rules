rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.role == 'admin' || request.auth.token.role == 'moderator' || request.auth.token.admin == true);
    }

    // Follow relationships
    match /follows/{followId} {
      allow read, write: if true;
    }

    // Public / User Profiles
    match /users/{userId} {
      allow read, write: if true;
    }

    // Posts & Feed Items
    match /posts/{postId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Stories
    match /stories/{storyId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Comments
    match /comments/{commentId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Direct Messages & 1-on-1 Chat Rooms (Deterministic chats/{chatId}/messages)
    match /chats/{chatId} {
      allow read, write: if true;
    }

    match /chats/{chatId}/messages/{messageId} {
      allow read, write: if true;
    }

    // Direct Messages & Legacy Chat Threads
    match /chat_threads/{threadId} {
      allow read, write: if true;
    }

    match /chat_threads/{threadId}/messages/{messageId} {
      allow read, write: if true;
    }

    // Communities & Community Messages
    match /communities/{communityId} {
      allow read, write: if true;
    }

    match /communities/{communityId}/messages/{messageId} {
      allow read, write: if true;
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // Safety & Moderation: User Reports (Confidential)
    match /universal_reports/{reportId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Bug Reports
    match /bug_reports/{bugId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Moderation Logs (Staff Only)
    match /moderation_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // User Grievances / Formal Complaints
    match /grievances/{grievanceId} {
      allow create, read: if true;
      allow update, delete: if isAdmin();
    }
  }
}
